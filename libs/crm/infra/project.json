{
  "name": "crm-infra",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/crm/infra/src",
  "prefix": "eak",
  "projectType": "library",
  "tags": ["scope:crm", "type:infra"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/crm/infra/ng-package.json",
        "tsConfig": "libs/crm/infra/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/crm/infra/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
